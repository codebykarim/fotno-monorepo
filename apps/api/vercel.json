{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "buildCommand": "cd ../.. && pnpm run build",
  "installCommand": "cd ../.. && pnpm install",
  "outputDirectory": "dist"
}
