generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "./prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @unique @default(uuid())
  name               String
  email              String
  plan               Plan             @default(FREE)
  trialEndsAt        DateTime?
  storageUsed        BigInt           @default(0)
  storageLimit       BigInt           @default(1073741824) // 1 GB
  galleryLimit       Int? // null = unlimited
  downgradedAt       DateTime? // tracks subscription expiry for 90-day retention
  storageReserved    BigInt           @default(0)
  overageBytes       BigInt           @default(0)
  overageResetAt     DateTime?
  stripeCustomerId   String?          @unique
  warningEmailSent80 Boolean          @default(false)
  warningEmailSent95 Boolean          @default(false)
  emailVerified      Boolean
  image              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  role               String?
  banned             Boolean?
  banReason          String?
  banExpires         DateTime?
  subscribed         Boolean?
  finishOnboarding   Boolean?
  sessions           Session[]
  accounts           Account[]
  subscriptions      Subscription[]
  userOnboarding     UserOnboarding?
  galleries          Gallery[]
  clients            Client[]
  storageEvents      StorageEvent[]
  driveImportJobs    DriveImportJob[]

  @@unique([email])
  @@map("user")
}

enum Plan {
  FREE
  TRIAL
  PRO
  EXPIRED
}

model Session {
  id             String   @id @unique @default(uuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @unique @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @unique @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@map("verification")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum SubscriptionSource {
  STRIPE
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source               SubscriptionSource
  status               SubscriptionStatus @default(ACTIVE)
  storageTierGb        Int
  priceCents           Int
  currency             String             @default("USD")
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  endsAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([userId])
  @@map("subscription")
}

enum UserType {
  SOLO
  COMPANY
}

enum PhotographyLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum ContactMethod {
  EMAIL
  PHONE
  BOTH
}

model UserOnboarding {
  id               Int               @id @unique @default(autoincrement())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType         UserType
  companyName      String?
  companySize      String?
  photographyType  String[]
  photographyLevel PhotographyLevel?
  contactMethod    ContactMethod?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@map("userOnboarding")
}

model Gallery {
  id           String    @id @unique @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  eventDate    DateTime?
  deadline     DateTime?
  coverPhotoId String?
  coverPhoto   Photo?    @relation("GalleryCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  passwordHash String?
  shareToken   String    @unique @default(uuid())
  isPublished  Boolean   @default(false)

  // General settings
  categoryTags         String[]  @default([])
  expiresAt            DateTime?
  slideshowEnabled     Boolean   @default(true)
  socialSharingEnabled Boolean   @default(true)
  emailRegistration    Boolean   @default(false)
  language             String    @default("en")

  // Download settings
  downloadEnabled      Boolean @default(true)
  downloadPin          String?
  downloadSizeOriginal Boolean @default(true)
  downloadSizeHighRes  Boolean @default(false)
  downloadSizeWeb      Boolean @default(true)
  downloadWebMaxPx     Int     @default(2048)
  downloadHighResMaxPx Int     @default(3600)
  downloadLimit        Int?
  downloadContactsOnly Boolean @default(false)

  // Favorites settings
  favoritesEnabled     Boolean @default(true)
  favoriteNotesEnabled Boolean @default(true)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  photos           Photo[]           @relation("GalleryPhotos")
  albums           Album[]
  clients          GalleryClient[]
  comments         GalleryComment[]
  driveImportItems DriveImportItem[]
  favorites        GalleryFavorite[]
  downloadEvents   DownloadEvent[]
  favoriteShares   FavoriteShare[]

  @@unique([userId, slug])
  @@map("gallery")
}

model Photo {
  id               String            @id @unique @default(uuid())
  galleryId        String
  gallery          Gallery           @relation("GalleryPhotos", fields: [galleryId], references: [id], onDelete: Cascade)
  usedAsCoverIn    Gallery[]         @relation("GalleryCoverPhoto")
  checksum         String?
  s3Key            String
  s3Bucket         String
  originalFilename String
  originalSize     BigInt            @default(0)
  thumbnailSize    BigInt            @default(0)
  previewSize      BigInt            @default(0)
  totalSize        BigInt            @default(0)
  width            Int?
  height           Int?
  mimeType         String
  order            Int               @default(0)
  isCulled         Boolean           @default(false)
  loved            Boolean           @default(false)
  thumbnailKey     String?
  previewKey       String?
  blurDataUrl      String?
  status           String            @default("pending")
  processedAt      DateTime?
  createdAt        DateTime          @default(now())
  uploadSession    UploadSession?
  albumPhotos      AlbumPhoto[]
  comments         GalleryComment[]
  favorites        GalleryFavorite[]

  @@index([galleryId, order])
  @@map("photo")
}

model UploadSession {
  id             String              @id @default(cuid())
  photoId        String              @unique
  photo          Photo               @relation(fields: [photoId], references: [id], onDelete: Cascade)
  s3UploadId     String
  s3Key          String
  totalParts     Int
  totalSize      BigInt
  completedParts Json                @default("[]")
  status         UploadSessionStatus @default(IN_PROGRESS)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum UploadSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  EXPIRED
}

model StorageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String?
  delta     BigInt
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("storage_event")
}

model Client {
  id        String          @id @unique @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  galleries GalleryClient[]

  @@unique([userId, email])
  @@map("client")
}

model GalleryClient {
  galleryId String
  clientId  String
  createdAt DateTime @default(now())
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([galleryId, clientId])
  @@map("gallery_client")
}

model Album {
  id              String       @id @unique @default(uuid())
  galleryId       String
  gallery         Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title           String
  downloadEnabled Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  photos          AlbumPhoto[]

  @@map("album")
}

model AlbumPhoto {
  albumId   String
  photoId   String
  createdAt DateTime @default(now())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  @@map("album_photo")
}

model GalleryComment {
  id         String           @id @default(uuid())
  galleryId  String
  gallery    Gallery          @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?           @relation(fields: [photoId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     GalleryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    GalleryComment[] @relation("CommentReplies")
  authorName String
  authorRole String           @default("client")
  viewerId   String?
  message    String
  likes      String[]         @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@index([galleryId, createdAt])
  @@map("gallery_comment")
}

model GalleryFavorite {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId   String
  viewerName String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([galleryId, photoId, viewerId])
  @@index([galleryId])
  @@map("gallery_favorite")
}

model FavoriteShare {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  viewerId   String
  viewerName String
  shareToken String   @unique @default(uuid())
  createdAt  DateTime @default(now())

  @@unique([galleryId, viewerId])
  @@map("favorite_share")
}

model DownloadEvent {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String?
  viewerId   String?
  viewerName String?
  viewerIp   String?
  type       String
  createdAt  DateTime @default(now())

  @@index([galleryId])
  @@map("download_event")
}

enum ImportSource {
  DRIVE
  PHOTOS
}

enum DriveImportStatus {
  PENDING
  LISTING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum DriveImportItemStatus {
  PENDING
  DOWNLOADING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model DriveImportJob {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         ImportSource      @default(DRIVE)
  status         DriveImportStatus @default(PENDING)
  totalFiles     Int               @default(0)
  completedFiles Int               @default(0)
  failedFiles    Int               @default(0)
  skippedFiles   Int               @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  items          DriveImportItem[]

  @@index([userId, status])
  @@map("drive_import_job")
}

// ── Pricing Config (admin-managed) ──────────────────────────────

model PricingTier {
  id            String   @id @default(uuid())
  gb            Int      @unique // -1 for unlimited, 0 for free
  label         String
  priceCents    Int // base USD price
  stripePriceId String?
  galleryLimit  Int? // null = unlimited
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("pricing_tier")
}

model RegionalPricing {
  id            String                 @id @default(uuid())
  countryCode   String                 @unique // ISO 3166-1 alpha-2
  currency      String // ISO 4217
  symbol        String
  locale        String // BCP 47
  pppMultiplier Float
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
  tierOverrides RegionalTierOverride[]

  @@map("regional_pricing")
}

model RegionalTierOverride {
  id                String          @id @default(uuid())
  regionalPricingId String
  regionalPricing   RegionalPricing @relation(fields: [regionalPricingId], references: [id], onDelete: Cascade)
  tierGb            Int // matches PricingTier.gb
  localPriceCents   Int // display price in local currency minor units
  checkoutCents     Int? // override checkout price in USD cents
  storageOverrideGb Int? // optional storage override
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@unique([regionalPricingId, tierGb])
  @@index([regionalPricingId])
  @@map("regional_tier_override")
}

model DriveImportItem {
  id              String                @id @default(uuid())
  jobId           String
  job             DriveImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  galleryId       String
  gallery         Gallery               @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  driveFolderId   String
  driveFolderName String
  driveFileId     String?
  driveFileName   String?
  driveFileSize   BigInt                @default(0)
  driveMimeType   String?
  photoId         String?
  status          DriveImportItemStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt

  @@index([jobId, status])
  @@map("drive_import_item")
}
