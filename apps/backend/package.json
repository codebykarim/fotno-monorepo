{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "main": "server.ts",
  "scripts": {
    "start": "tsc && node api/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only --inspect --ignore node_modules api/index.ts",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest --detectOpenHandles"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "morgan": "^1.10.0",
    "@types/body-parser": "^1.19.5",
    "@types/express-serve-static-core": "^5.0.1",
    "@repo/logger": "workspace:*",
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.12.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.7.3"
  }
}
