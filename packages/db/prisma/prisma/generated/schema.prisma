generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "./prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @unique @default(uuid())
  name                   String
  email                  String
  plan                   Plan                    @default(FREE)
  storageUsed            BigInt                  @default(0)
  storageLimit           BigInt                  @default(1073741824) // 1 GB
  galleryLimit           Int? // null = unlimited
  downgradedAt           DateTime? // tracks subscription expiry for 90-day retention
  storageReserved        BigInt                  @default(0)
  overageBytes           BigInt                  @default(0)
  overageResetAt         DateTime?
  stripeCustomerId       String?                 @unique
  warningEmailSent80     Boolean                 @default(false)
  warningEmailSent95     Boolean                 @default(false)
  emailVerified          Boolean
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  role                   String?
  banned                 Boolean?
  banReason              String?
  banExpires             DateTime?
  country                String? // ISO 3166-1 alpha-2 country code (auto-detected from IP)
  subscribed             Boolean?
  finishOnboarding       Boolean?
  sessions               Session[]
  accounts               Account[]
  subscriptions          Subscription[]
  userOnboarding         UserOnboarding?
  galleries              Gallery[]
  storageEvents          StorageEvent[]
  driveImportJobs        DriveImportJob[]
  smartAlbumConfig       SmartAlbumConfig?
  notificationPreference NotificationPreference?
  fcmTokens              FcmToken[]
  customDomain           CustomDomain?
  notifications          Notification[]

  @@unique([email])
  @@map("user")
}

enum Plan {
  FREE
  PRO
  EXPIRED
}

model Session {
  id             String   @id @unique @default(uuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @unique @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @unique @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@map("verification")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum SubscriptionSource {
  STRIPE
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source               SubscriptionSource
  status               SubscriptionStatus @default(ACTIVE)
  storageTierGb        Int
  priceCents           Int
  currency             String             @default("USD")
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  endsAt               DateTime?
  pendingTierGb        Int? // pending downgrade tier (applied at period end)
  pendingEffectiveAt   DateTime? // when the pending downgrade takes effect
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([userId])
  @@map("subscription")
}

enum UserType {
  SOLO
  COMPANY
}

enum PhotographyLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum ContactMethod {
  EMAIL
  PHONE
  BOTH
}

model UserOnboarding {
  id               Int               @id @unique @default(autoincrement())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType         UserType
  companyName      String?
  companySize      String?
  photographyType  String[]
  photographyLevel PhotographyLevel?
  contactMethod    ContactMethod?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@map("userOnboarding")
}

model Gallery {
  id           String    @id @unique @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  eventDate    DateTime?
  deadline     DateTime?
  coverPhotoId String?
  coverPhoto   Photo?    @relation("GalleryCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  passwordHash String?
  shareToken   String    @unique @default(uuid())
  isPublished  Boolean   @default(false)

  // General settings
  categoryTags         String[]  @default([])
  expiresAt            DateTime?
  slideshowEnabled     Boolean   @default(false)
  socialSharingEnabled Boolean   @default(true)
  emailRegistration    Boolean   @default(false)
  language             String    @default("en")

  // Download settings
  downloadEnabled      Boolean @default(true)
  downloadPin          String?
  downloadSizeOriginal Boolean @default(true)
  downloadSizeHighRes  Boolean @default(false)
  downloadSizeWeb      Boolean @default(false)
  downloadWebMaxPx     Int     @default(2048)
  downloadHighResMaxPx Int     @default(3600)
  downloadLimit        Int?
  // Favorites settings
  favoritesEnabled     Boolean @default(true)
  favoriteNotesEnabled Boolean @default(true)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  photos            Photo[]            @relation("GalleryPhotos")
  albums            Album[]
  comments          GalleryComment[]
  driveImportItems  DriveImportItem[]
  favorites         GalleryFavorite[]
  downloadEvents    DownloadEvent[]
  galleryViews      GalleryView[]
  favoriteShares    FavoriteShare[]
  smartAlbumDesigns SmartAlbumDesign[]

  @@unique([userId, slug])
  @@map("gallery")
}

model Photo {
  id               String            @id @unique @default(uuid())
  galleryId        String
  gallery          Gallery           @relation("GalleryPhotos", fields: [galleryId], references: [id], onDelete: Cascade)
  usedAsCoverIn    Gallery[]         @relation("GalleryCoverPhoto")
  checksum         String?
  s3Key            String
  s3Bucket         String
  originalFilename String
  originalSize     BigInt            @default(0)
  thumbnailSize    BigInt            @default(0)
  previewSize      BigInt            @default(0)
  totalSize        BigInt            @default(0)
  width            Int?
  height           Int?
  mimeType         String
  order            Int               @default(0)
  isCulled         Boolean           @default(false)
  loved            Boolean           @default(false)
  thumbnailKey     String?
  previewKey       String?
  blurDataUrl      String?
  status           String            @default("pending")
  processedAt      DateTime?
  createdAt        DateTime          @default(now())
  uploadSession    UploadSession?
  albumPhotos      AlbumPhoto[]
  comments         GalleryComment[]
  favorites        GalleryFavorite[]

  @@index([galleryId, order])
  @@map("photo")
}

model UploadSession {
  id             String              @id @default(cuid())
  photoId        String              @unique
  photo          Photo               @relation(fields: [photoId], references: [id], onDelete: Cascade)
  s3UploadId     String
  s3Key          String
  totalParts     Int
  totalSize      BigInt
  completedParts Json                @default("[]")
  status         UploadSessionStatus @default(IN_PROGRESS)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum UploadSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  EXPIRED
}

model StorageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String?
  delta     BigInt
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("storage_event")
}

model Album {
  id              String       @id @unique @default(uuid())
  galleryId       String
  gallery         Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title           String
  downloadEnabled Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  photos          AlbumPhoto[]

  @@map("album")
}

model AlbumPhoto {
  albumId   String
  photoId   String
  createdAt DateTime @default(now())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  @@map("album_photo")
}

model GalleryComment {
  id         String           @id @default(uuid())
  galleryId  String
  gallery    Gallery          @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?           @relation(fields: [photoId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     GalleryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    GalleryComment[] @relation("CommentReplies")
  authorName String
  authorRole String           @default("client")
  viewerId   String?
  message    String
  likes      String[]         @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@index([galleryId, createdAt])
  @@map("gallery_comment")
}

model GalleryFavorite {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId   String
  viewerName String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([galleryId, photoId, viewerId])
  @@index([galleryId])
  @@map("gallery_favorite")
}

model FavoriteShare {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  viewerId   String
  viewerName String
  shareToken String   @unique @default(uuid())
  createdAt  DateTime @default(now())

  @@unique([galleryId, viewerId])
  @@map("favorite_share")
}

model DownloadEvent {
  id         String   @id @default(uuid())
  galleryId  String
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String?
  viewerId   String?
  viewerName String?
  viewerIp   String?
  type       String
  createdAt  DateTime @default(now())

  @@index([galleryId])
  @@map("download_event")
}

model GalleryView {
  id        String   @id @default(uuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  viewerIp  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([galleryId])
  @@index([galleryId, createdAt])
  @@map("gallery_view")
}

enum ImportSource {
  DRIVE
  PHOTOS
}

enum DriveImportStatus {
  PENDING
  LISTING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum DriveImportItemStatus {
  PENDING
  DOWNLOADING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model DriveImportJob {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         ImportSource      @default(DRIVE)
  status         DriveImportStatus @default(PENDING)
  totalFiles     Int               @default(0)
  completedFiles Int               @default(0)
  failedFiles    Int               @default(0)
  skippedFiles   Int               @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  items          DriveImportItem[]

  @@index([userId, status])
  @@map("drive_import_job")
}

// ── Pricing Config (admin-managed) ──────────────────────────────

model PricingTier {
  id                  String        @id @default(uuid())
  gb                  Int           @unique // -1 for unlimited, 0 for free
  label               String
  priceCents          Int // base USD price (monthly)
  priceCentsAnnual    Int? // annual USD price (full year, in cents); null = no annual option
  stripePriceId       String? // monthly recurring price ID
  stripePriceIdAnnual String? // annual recurring price ID
  galleryLimit        Int? // null = unlimited
  sortOrder           Int           @default(0)
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  features            TierFeature[]

  @@map("pricing_tier")
}

model TierFeature {
  id         String      @id @default(uuid())
  tierId     String
  tier       PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  featureKey String
  createdAt  DateTime    @default(now())

  @@unique([tierId, featureKey])
  @@index([tierId])
  @@map("tier_feature")
}

model RegionalPricing {
  id            String                 @id @default(uuid())
  countryCode   String                 @unique // ISO 3166-1 alpha-2
  currency      String // ISO 4217
  symbol        String
  locale        String // BCP 47
  pppMultiplier Float
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt
  tierOverrides RegionalTierOverride[]

  @@map("regional_pricing")
}

model RegionalTierOverride {
  id                String          @id @default(uuid())
  regionalPricingId String
  regionalPricing   RegionalPricing @relation(fields: [regionalPricingId], references: [id], onDelete: Cascade)
  tierGb            Int // matches PricingTier.gb
  localPriceCents   Int // display price in local currency minor units
  checkoutCents     Int? // override checkout price in USD cents
  storageOverrideGb Int? // optional storage override
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@unique([regionalPricingId, tierGb])
  @@index([regionalPricingId])
  @@map("regional_tier_override")
}

model DriveImportItem {
  id              String                @id @default(uuid())
  jobId           String
  job             DriveImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  galleryId       String
  gallery         Gallery               @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  driveFolderId   String
  driveFolderName String
  driveFileId     String?
  driveFileName   String?
  driveFileSize   BigInt                @default(0)
  driveMimeType   String?
  photoId         String?
  status          DriveImportItemStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt

  @@index([jobId, status])
  @@map("drive_import_item")
}

// ── Smart Album Workflow ─────────────────────────────────────

enum SmartAlbumPaymentMethod {
  OUTSIDE_FOTNO
  INSIDE_FOTNO
}

enum SmartAlbumDesignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SmartAlbumSubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SmartAlbumTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model SmartAlbumConfig {
  id                     String                  @id @default(uuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled                Boolean                 @default(false)
  paymentMethod          SmartAlbumPaymentMethod @default(OUTSIDE_FOTNO)
  stripeConnectAccountId String?
  stripeConnectOnboarded Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  products               SmartAlbumProduct[]

  @@map("smart_album_config")
}

model SmartAlbumProduct {
  id                String             @id @default(uuid())
  configId          String
  config            SmartAlbumConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  name              String
  widthCm           Float
  heightCm          Float
  coverType         String
  paperType         String
  maxSpreads        Int
  minSpreads        Int?
  allowFewerSpreads Boolean            @default(false)
  hasCover          Boolean            @default(true)
  hasFirstPage      Boolean            @default(true)
  hasLastPage       Boolean            @default(true)
  images            Json               @default("[]")
  priceCents        Int
  currency          String             @default("USD")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  designs           SmartAlbumDesign[]

  @@unique([configId, widthCm, heightCm, coverType, paperType])
  @@index([configId])
  @@map("smart_album_product")
}

model SmartAlbumDesign {
  id          String                 @id @default(uuid())
  galleryId   String
  gallery     Gallery                @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  productId   String
  product     SmartAlbumProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  clientName  String
  clientEmail String
  title       String                 @default("Untitled Album")
  designData  Json                   @default("{}")
  status      SmartAlbumDesignStatus @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions SmartAlbumSubmission[]

  @@index([galleryId, status])
  @@index([galleryId, clientEmail])
  @@map("smart_album_design")
}

model SmartAlbumSubmission {
  id                String                     @id @default(uuid())
  designId          String
  design            SmartAlbumDesign           @relation(fields: [designId], references: [id], onDelete: Cascade)
  version           Int                        @default(1)
  designSnapshot    Json
  status            SmartAlbumSubmissionStatus @default(PENDING)
  photographerNotes String?
  reviewedAt        DateTime?
  submittedAt       DateTime                   @default(now())
  exportReady       Boolean                    @default(false)
  exportUrl         String?
  transaction       SmartAlbumTransaction?

  @@unique([designId, version])
  @@index([designId, status])
  @@map("smart_album_submission")
}

model SmartAlbumTransaction {
  id                    String                      @id @default(uuid())
  submissionId          String                      @unique
  submission            SmartAlbumSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String                      @unique
  amountCents           Int
  feeCents              Int
  netCents              Int
  currency              String                      @default("USD")
  status                SmartAlbumTransactionStatus @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime                    @default(now())

  @@map("smart_album_transaction")
}

// ── Settings: Notification Preferences ──────────────────────────

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryExpiryBrowser  Boolean  @default(false)
  galleryExpiryEmail    Boolean  @default(false)
  storageWarningBrowser Boolean  @default(false)
  storageWarningEmail   Boolean  @default(false)
  billingFailedBrowser  Boolean  @default(false)
  billingFailedEmail    Boolean  @default(false)
  commentsBrowser       Boolean  @default(false)
  commentsEmail         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  @@map("notification_preference")
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("fcm_token")
}

// ── Settings: Custom Domain ─────────────────────────────────────

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model CustomDomain {
  id                   String       @id @default(uuid())
  userId               String       @unique
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain               String       @unique
  status               DomainStatus @default(PENDING)
  verificationToken    String       @unique @default(uuid())
  cloudflareHostnameId String?
  verifiedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt

  @@map("custom_domain")
}

// ── In-App Notifications ────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // e.g. "comments", "galleryExpiry", etc.
  title      String
  body       String
  data       Json? // optional payload (galleryId, commentId, etc.)
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isArchived, createdAt])
  @@map("notification")
}

model InboundEmail {
  id        String   @id @default(uuid())
  resendId  String   @unique // Resend email_id for deduplication
  from      String
  to        String[] // recipient addresses
  cc        String[]
  bcc       String[]
  subject   String
  text      String? // plain text body
  html      String? // HTML body
  isRead    Boolean  @default(false)
  isStarred Boolean  @default(false)
  createdAt DateTime @default(now()) // when we received it
  sentAt    DateTime // when the email was originally sent

  @@index([isRead, createdAt])
  @@map("inbound_email")
}
