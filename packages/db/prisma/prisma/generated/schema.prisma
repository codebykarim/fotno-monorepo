generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "./prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @unique @default(uuid())
  name               String
  email              String
  plan               Plan            @default(FREE)
  storageUsed        BigInt          @default(0)
  storageLimit       BigInt          @default(0)
  storageReserved    BigInt          @default(0)
  overageBytes       BigInt          @default(0)
  overageResetAt     DateTime?
  stripeCustomerId   String?         @unique
  stripeSubId        String?         @unique
  warningEmailSent80 Boolean         @default(false)
  warningEmailSent95 Boolean         @default(false)
  emailVerified      Boolean
  image              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  role               String?
  banned             Boolean?
  banReason          String?
  banExpires         DateTime?
  subscribed         Boolean?
  finishOnboarding   Boolean?
  sessions           Session[]
  accounts           Account[]
  payment            Payment[]
  userOnboarding     UserOnboarding?
  galleries          Gallery[]
  clients            Client[]
  storageEvents      StorageEvent[]

  @@unique([email])
  @@map("user")
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
}

model Session {
  id             String   @id @unique @default(uuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @unique @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @unique @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@map("verification")
}

enum PlanType {
  BEGGINER
  PRO
  STUDIO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Payment {
  id                  Int                @id @unique @default(autoincrement())
  planId              Int
  plan                PlanType
  planExpiresAt       DateTime?
  planStartedAt       DateTime?
  amount_cents        Int
  transactionId       Int                @unique
  initial_transaction Int
  subscriptionId      Int                @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  status              SubscriptionStatus
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment")
}

enum UserType {
  SOLO
  COMPANY
}

enum PhotographyLevel {
  BEGINNER
  INTERMEDIATE
  PROFESSIONAL
}

enum ContactMethod {
  EMAIL
  PHONE
  BOTH
}

model UserOnboarding {
  id               Int               @id @unique @default(autoincrement())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userType         UserType
  companyName      String?
  companySize      String?
  photographyType  String[]
  photographyLevel PhotographyLevel?
  contactMethod    ContactMethod?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@map("userOnboarding")
}

model Gallery {
  id           String           @id @unique @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  eventDate    DateTime?
  deadline     DateTime?
  coverPhotoId String?
  coverPhoto   Photo?           @relation("GalleryCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  passwordHash String?
  shareToken   String           @unique @default(uuid())
  aiContext    String?
  isPublished  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  photos       Photo[]          @relation("GalleryPhotos")
  albums       Album[]
  clients      GalleryClient[]
  comments     GalleryComment[]

  @@unique([userId, slug])
  @@map("gallery")
}

model Photo {
  id               String           @id @unique @default(uuid())
  galleryId        String
  gallery          Gallery          @relation("GalleryPhotos", fields: [galleryId], references: [id], onDelete: Cascade)
  usedAsCoverIn    Gallery[]        @relation("GalleryCoverPhoto")
  checksum         String?
  s3Key            String
  s3Bucket         String
  originalFilename String
  originalSize     BigInt           @default(0)
  thumbnailSize    BigInt           @default(0)
  previewSize      BigInt           @default(0)
  totalSize        BigInt           @default(0)
  width            Int?
  height           Int?
  mimeType         String
  order            Int              @default(0)
  isCulled         Boolean          @default(false)
  loved            Boolean          @default(false)
  aiCaption        String?
  aiTags           String[]
  faceCount        Int              @default(0)
  thumbnailKey     String?
  previewKey       String?
  status           String           @default("pending")
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  uploadSession    UploadSession?
  albumPhotos      AlbumPhoto[]
  comments         GalleryComment[]

  @@index([galleryId, order])
  @@map("photo")
}

model UploadSession {
  id             String              @id @default(cuid())
  photoId        String              @unique
  photo          Photo               @relation(fields: [photoId], references: [id], onDelete: Cascade)
  s3UploadId     String
  s3Key          String
  totalParts     Int
  totalSize      BigInt
  completedParts Json                @default("[]")
  status         UploadSessionStatus @default(IN_PROGRESS)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum UploadSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  EXPIRED
}

model StorageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String?
  delta     BigInt
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("storage_event")
}

model Client {
  id        String          @id @unique @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  galleries GalleryClient[]

  @@unique([userId, email])
  @@map("client")
}

model GalleryClient {
  galleryId String
  clientId  String
  createdAt DateTime @default(now())
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([galleryId, clientId])
  @@map("gallery_client")
}

model Album {
  id        String       @id @unique @default(uuid())
  galleryId String
  gallery   Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  photos    AlbumPhoto[]

  @@map("album")
}

model AlbumPhoto {
  albumId   String
  photoId   String
  createdAt DateTime @default(now())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([albumId, photoId])
  @@map("album_photo")
}

model GalleryComment {
  id         String           @id @default(uuid())
  galleryId  String
  gallery    Gallery          @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId    String?
  photo      Photo?           @relation(fields: [photoId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     GalleryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    GalleryComment[] @relation("CommentReplies")
  authorName String
  authorRole String           @default("client")
  viewerId   String?
  message    String
  likes      String[]         @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@index([galleryId, createdAt])
  @@map("gallery_comment")
}

model ImageSearchImage {
  id           String                       @id @default(uuid())
  photoId      String                       @unique
  userId       String
  galleryId    String
  storageUrl   String
  thumbnailUrl String?
  caption      String?
  tags         String[]
  metadata     Json?
  embedding    Unsupported("vector(1152)")?
  indexedAt    DateTime?
  version      Int                          @default(1)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @default(now()) @updatedAt

  @@index([galleryId, userId])
  @@index([photoId])
  @@map("image_search_image")
}

model ImageSearchAlbumCache {
  id               String   @id @default(uuid())
  galleryId        String
  userId           String
  normalizedPrompt String
  photoIds         String[]
  albumTitle       String?
  albumDescription String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([galleryId, userId, normalizedPrompt])
  @@index([galleryId, userId])
  @@index([expiresAt])
  @@map("image_search_album_cache")
}
