{
  "name": "image-search-service",
  "version": "0.0.1",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore node_modules src/server.ts",
    "db:deploy": "node scripts/db-deploy.cjs",
    "db:reset": "node scripts/db-reset.cjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@workspace/db": "workspace:*",
    "@workspace/lib": "workspace:*",
    "bullmq": "^5.34.0",
    "cors": "latest",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "helmet": "latest",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "latest",
    "openai": "^4.72.0",
    "pg": "latest",
    "pgvector": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "ts-node-dev": "^2.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
