  "scripts": {
    "start": "tsc && node dist/server.js",
    "build": "tsc",
    "dev:server": "ts-node-dev --respawn --transpile-only --inspect=9230 --ignore node_modules src/server.ts",
    "dev:worker:cleanup": "ts-node-dev --respawn --transpile-only --ignore node_modules src/workers/cleanupPhotoWorker.ts",
    "dev": "sh -c 'pnpm run dev:server & pnpm run dev:worker:cleanup; wait'",
    "worker:cleanup": "ts-node-dev --respawn --transpile-only --ignore node_modules src/workers/cleanupPhotoWorker.ts",
    "worker:reconcile-storage": "ts-node-dev --respawn --transpile-only --ignore node_modules src/workers/reconcileStorageWorker.ts",
    "worker:expiry": "ts-node-dev --respawn --transpile-only --ignore node_modules src/workers/expiryWorker.ts",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
