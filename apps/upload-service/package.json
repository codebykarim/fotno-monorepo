{
  "name": "upload-service",
  "version": "0.0.1",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore node_modules src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@workspace/db": "workspace:*",
    "@workspace/lib": "workspace:*",
    "bullmq": "latest",
    "cors": "latest",
    "express": "^5.0.0",
    "helmet": "latest",
    "ioredis": "latest",
    "jsonwebtoken": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "sharp": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "ts-node-dev": "^2.0.0"
  }
}
